<UserControl x:Class="NeeView.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:properties="clr-namespace:NeeView.Properties"
             xmlns:local="clr-namespace:NeeView"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:NullableToVisibilityConverter x:Key="NullableToVisibilityConverter" />
        <Style x:Key="WelcomeCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Notification.Background}" />
            <Setter Property="BorderBrush" Value="#307EABC4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style x:Key="WelcomeLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Notification.Foreground}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="WelcomeExtensions" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Notification.Foreground}" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="MainViewPanel" ContextMenu="{Binding ContextMenu}" ContextMenuOpening="MainViewPanel_ContextMenuOpening" Background="Transparent" >
        <Grid x:Name="MainViewCanvas" Margin="{Binding MainViewMargin}">

            <!-- Active Marker -->
            <local:ActiveMarker x:Name="ActiveMarker" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"/>

            <!-- メインビュー コンテンツ表示領域 -->
            <Grid x:Name="View" Background="Transparent" SizeChanged="MainView_SizeChanged" Focusable="True" KeyboardNavigation.IsTabStop="True"
                    FocusVisualStyle="{x:Null}"
                    AllowDrop="True">
                <ContentControl x:Name="SocketView" Content="{Binding PageFrameBoxPresenter.View}" Focusable="False"/>
                <ContentControl x:Name="SocketNext" Content="{Binding PageFrameBoxPresenter.ViewNext}" Focusable="False" Visibility="Hidden"/>
            </Grid>
        </Grid>

        <!-- Welcome screen: stays out of the drop target and only appears with no book open. -->
        <Viewbox Margin="32" Stretch="Uniform" StretchDirection="DownOnly" IsHitTestVisible="False">
            <Viewbox.Style>
                <Style TargetType="Viewbox">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding PageFrameBoxPresenter.View}" Value="{x:Null}" />
                                <Condition Binding="{Binding PageFrameBoxPresenter.EmptyMessage}" Value="{x:Null}" />
                                <Condition Binding="{Binding Source={x:Static local:BookHub.Current}, Path=IsLoading}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Viewbox.Style>
            <StackPanel Width="700">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Border Width="44" Height="44" CornerRadius="14" Background="#183E9CD6" Margin="0,0,12,0">
                        <Path Width="20" Height="28" Stretch="Uniform" Fill="#62BAEE"
                              Data="M 12,0 C 10,6 0,15 0,22 A 12,12 0 0 0 24,22 C 24,15 14,6 12,0 Z" />
                    </Border>
                    <TextBlock Text="물뷰" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Notification.Foreground}" />
                </StackPanel>
                <TextBlock Text="좋아하는 파일을, 가볍게 열어보세요" FontSize="18" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Notification.Foreground}" Margin="0,0,0,9" />
                <TextBlock Text="파일이나 폴더를 이곳에 끌어다 놓으세요" FontSize="13" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Notification.Foreground}" Opacity="0.6" />
                <Grid Margin="0,27,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <Border Style="{StaticResource WelcomeCard}">
                        <StackPanel>
                            <TextBlock Text="이미지" Style="{StaticResource WelcomeLabel}" />
                            <TextBlock Text="JPG · JPEG · PNG · GIF · WEBP&#10;BMP · TIFF · SVG 외" Style="{StaticResource WelcomeExtensions}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource WelcomeCard}">
                        <StackPanel>
                            <TextBlock Text="압축파일 · 만화" Style="{StaticResource WelcomeLabel}" />
                            <TextBlock Text="ZIP · RAR · 7Z · LZH&#10;CBZ · CBR · CB7 · CBT" Style="{StaticResource WelcomeExtensions}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource WelcomeCard}">
                        <StackPanel>
                            <TextBlock Text="문서 · 텍스트" Style="{StaticResource WelcomeLabel}" />
                            <TextBlock Text="PDF · TXT" Style="{StaticResource WelcomeExtensions}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource WelcomeCard}">
                        <StackPanel>
                            <TextBlock Text="동영상" Style="{StaticResource WelcomeLabel}" />
                            <TextBlock Text="MP4 · MKV · AVI · MOV · WMV · ASF" Style="{StaticResource WelcomeExtensions}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource WelcomeCard}">
                        <DockPanel>
                            <TextBlock Text="음악" Style="{StaticResource WelcomeLabel}" Margin="0,0,18,0" />
                            <TextBlock Text="MP3" Style="{StaticResource WelcomeExtensions}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>
                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource Notification.Foreground}" FontSize="12" Opacity="0.6">
                    <Run Text="Ctrl + O" FontWeight="SemiBold" /><Run Text="  파일 열기     ·     " />
                    <Run Text="F4" FontWeight="SemiBold" /><Run Text="  파일 닫기" />
                </TextBlock>
                <TextBlock Text="일부 형식은 설정이나 설치된 코덱에 따라 달라질 수 있어요" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Notification.Foreground}" FontSize="11" Opacity="0.4" Margin="0,14,0,0" />
            </StackPanel>
        </Viewbox>

        <!-- empty pages message -->
        <Grid Visibility="{Binding PageFrameBoxPresenter.EmptyMessage, Converter={StaticResource NullableToVisibilityConverter}}" d:IsHidden="True" IsHitTestVisible="False">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center"  Background="{DynamicResource Notification.Background}" CornerRadius="10" >
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="300" Margin="40,20">
                    <TextBlock Text="{properties:TextBinding Notice.CannotDisplay}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="{StaticResource InfoTextFontSize}"
                        FontFamily="Meiryo" Foreground="{DynamicResource Notification.Foreground}" Margin="0,10"/>
                    <local:XHtmlTextBlock Source="{Binding PageFrameBoxPresenter.EmptyMessage}" Foreground="{DynamicResource Notification.Foreground}" HorizontalAlignment="Center" Margin="0,10"
                        MinHeight="0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- loupe info -->
        <Grid Visibility="{Binding Source={x:Static local:Config.Current}, Path=Loupe.IsVisibleLoupeInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid x:Name="LoupeInfo" Height="30" VerticalAlignment="Top" HorizontalAlignment="Right" DataContext="{Binding LoupeContext}"
                    Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="{Binding ElementName=MainViewCanvas, Path=Margin}" Background="{DynamicResource Notification.Background}">
                <TextBlock VerticalAlignment="Center" Padding="20,0" Foreground="{DynamicResource Notification.Foreground}" Text="{Binding Scale, StringFormat={}×{0:.0}}" />
            </Grid>
        </Grid>

        <!-- SlideShow time -->
        <local:SimpleProgressBar x:Name="SlideShowTimer" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="4"
                                 Foreground="{DynamicResource Control.Accent}" 
                                 Visibility="Collapsed"/>

        <!-- Now Loading -->
        <local:NowLoadingView x:Name="NowLoadingView" />

        <!-- Message Tiny -->
        <local:TinyInfoMessageView Source="{Binding InfoMessage.TinyInfoMessage}" />

        <!-- IsBusy -->
        <Grid Margin="{Binding ElementName=MainViewCanvas, Path=Margin}">
            <Rectangle Fill="{StaticResource Signal.Busy}" Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Visibility="{Binding BusyVisibility}" />
        </Grid>

        <!-- Processing -->
        <local:ProgressRing Radius="8"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="{Binding ElementName=MainViewCanvas, Path=Margin}"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- CommandMenu -->
        <Grid x:Name="CommandMenuGrid">
            <Grid.ContextMenu>
                <ContextMenu x:Name="CommandContextMenu"/>
            </Grid.ContextMenu>
        </Grid>

    </Grid>
</UserControl>
